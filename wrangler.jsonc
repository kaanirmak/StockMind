{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockmind",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 17 * * 1-5",
      "*/15 7-17 * * 1-5"
    ]
  },
  "vars": {
    "EMAIL_TRANSPORT": "gmail"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
