# ==============================================================================
# StockMind - Environment Template (.env.example)
# ==============================================================================
#
# Yerel geliştirme için: .env.local dosyasına kopyalayın.
# Canlı / Vercel için:   .env.production dosyasına veya Vercel Settings paneline yapıştırın.
#
# ==============================================================================

# --- Supabase (Veritabanı & Kimlik Doğrulama) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Supabase Admin / Service Role (Cron ve Arka Plan Görevleri İçin)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- OpenRouter AI (Finansal Analiz & Portföy Danışmanı Motoru) ---
OPENROUTER_API_KEY=your-openrouter-api-key

# --- Uygulama URL ---
# Local için:       http://localhost:3000
# Production için:  https://stockmind.vercel.app (veya kendi özel alan adınız)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Zamanlanmış Görevler (Cron / Background Workers Güvenliği) ---
CRON_SECRET=your-secure-cron-secret

# --- E-posta Bildirim Servisi (SMTP) ---
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=StockMind <your-email@gmail.com>
