{
  "name": "stockmind",
  "version": "1.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "sync:funds": "node scripts/sync-tefas-funds.mjs",
    "build:apk": "export JAVA_HOME=\"${JAVA_HOME:-$(if [ -d '/Applications/Android Studio.app/Contents/jbr/Contents/Home' ]; then echo '/Applications/Android Studio.app/Contents/jbr/Contents/Home'; else echo '/opt/homebrew/opt/openjdk@21'; fi)}\" && export PATH=\"$JAVA_HOME/bin:$PATH\" && cd android && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../StockMind.apk && cp app/build/outputs/apk/debug/app-debug.apk ../public/StockMind.apk",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test tests/security.test.cjs",
    "test:portfolio": "node --test tests/portfolio.test.cjs",
    "test": "node --test tests/security.test.cjs tests/portfolio.test.cjs tests/interaction.test.cjs",
    "test:interaction": "node --test tests/interaction.test.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lightweight-charts": "^5.2.1",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
